# Optional path overrides. SQLite remains authoritative.
AL_SADI_DB_PATH=E:\\al sadi\\factory.db
AL_SADI_WORKBOOK_PATH=E:\\al sadi\\factory_records.xlsx
AL_SADI_EXPORTS_PATH=E:\\al sadi\\exports
AL_SADI_BACKUPS_PATH=E:\\al sadi\\backups
AL_SADI_DEMO_MODE=false

# Worksheet protection prevents accidental edits; it is not encryption.
AL_SADI_SHEET_PASSWORD=replace-with-a-local-value

# Telegram secrets. Never commit a real bot token.
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Optional approved private group/supergroup numeric chat ID. Private chats remain allowed.
TELEGRAM_APPROVED_GROUP_ID=
